* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


html {
    scroll-behavior: smooth;
}


body {
    font-family: Arial, Helvetica, sans-serif;

    background:
        radial-gradient(
            circle at 80% 10%,
            rgba(113, 70, 190, 0.08),
            transparent 30%
        ),
        #060608;

    color: #f5f3ff;

    line-height: 1.6;

    overflow-x: hidden;
}


a {
    text-decoration: none;
    color: inherit;
}


button,
input,
textarea,
select {
    font-family: inherit;
}


::selection {
    background: #8b5cf6;
    color: white;
}


/* ================= NAVBAR ================= */

.header {
    position: fixed;

    top: 0;
    left: 0;

    width: 100%;

    z-index: 1000;

    background: rgba(6, 6, 8, 0.72);

    backdrop-filter: blur(20px);

    border-bottom:
        1px solid
        rgba(255, 255, 255, 0.06);
}


.navbar {
    max-width: 1200px;

    height: 78px;

    margin: auto;

    padding: 0 25px;

    display: flex;

    align-items: center;

    justify-content: space-between;
}


.logo {
    font-size: 25px;

    font-weight: 800;

    letter-spacing: 3px;
}


.logo span {
    color: #a78bfa;
}


.nav-links {
    display: flex;

    align-items: center;

    gap: 32px;

    list-style: none;
}


.nav-links a {
    color: #a6a3b2;

    font-size: 14px;

    transition: 0.3s;
}


.nav-links a:hover {
    color: white;
}


.nav-btn {
    padding: 11px 22px;

    border-radius: 8px;

    background:
        linear-gradient(
            135deg,
            #8b5cf6,
            #6366f1
        );

    font-size: 14px;

    transition: 0.3s;
}


.nav-btn:hover {
    transform: translateY(-2px);

    box-shadow:
        0 10px 30px
        rgba(124, 92, 255, 0.3);
}


.menu-btn {
    display: none;

    background: none;

    border: none;

    color: white;

    font-size: 28px;

    cursor: pointer;
}


/* ================= HERO ================= */

.hero {
    min-height: 100vh;

    max-width: 1200px;

    margin: auto;

    padding:
        150px
        25px
        100px;

    display: grid;

    grid-template-columns:
        1.05fr
        0.95fr;

    gap: 60px;

    align-items: center;

    position: relative;
}


.hero-background-glow {
    position: absolute;

    width: 500px;

    height: 500px;

    left: -220px;

    top: 150px;

    background: #7c3aed;

    opacity: 0.09;

    filter: blur(140px);

    border-radius: 50%;

    pointer-events: none;
}


.hero-label {
    display: inline-flex;

    align-items: center;

    gap: 9px;

    color: #a78bfa;

    font-size: 12px;

    font-weight: 700;

    letter-spacing: 3px;
}


.label-dot {
    width: 7px;

    height: 7px;

    border-radius: 50%;

    background: #a78bfa;

    box-shadow:
        0 0 12px
        #a78bfa;
}


.hero h1 {
    max-width: 750px;

    margin:
        22px
        0
        25px;

    font-size:
        clamp(
            44px,
            6vw,
            74px
        );

    line-height: 1.04;

    letter-spacing: -2px;
}


.hero h1 span {
    display: block;

    background:
        linear-gradient(
            90deg,
            #c4b5fd,
            #8b5cf6,
            #6366f1
        );

    -webkit-background-clip: text;

    -webkit-text-fill-color: transparent;
}


.hero-description {
    max-width: 650px;

    color: #92909e;

    font-size: 17px;

    line-height: 1.8;

    margin-bottom: 32px;
}


.hero-buttons {
    display: flex;

    gap: 14px;

    flex-wrap: wrap;
}


.btn-primary {
    display: inline-flex;

    align-items: center;

    gap: 12px;

    padding:
        13px
        22px;

    border: none;

    border-radius: 8px;

    background:
        linear-gradient(
            135deg,
            #8b5cf6,
            #6366f1
        );

    color: white;

    font-size: 14px;

    font-weight: 600;

    cursor: pointer;

    transition: 0.3s;
}


.btn-primary:hover {
    transform: translateY(-3px);

    box-shadow:
        0 15px 40px
        rgba(124, 92, 255, 0.3);
}


.btn-secondary {
    display: inline-flex;

    align-items: center;

    padding:
        13px
        22px;

    border:
        1px solid
        rgba(255, 255, 255, 0.12);

    border-radius: 8px;

    color: #dedbe9;

    font-size: 14px;

    transition: 0.3s;
}


.btn-secondary:hover {
    border-color: #8b5cf6;

    background:
        rgba(139, 92, 246, 0.06);
}


/* HERO STATS */

.hero-stats {
    display: flex;

    align-items: center;

    gap: 22px;

    margin-top: 55px;
}


.stat {
    display: flex;

    flex-direction: column;
}


.stat strong {
    font-size: 20px;

    color: white;
}


.stat span {
    color: #6f6c79;

    font-size: 11px;

    margin-top: 2px;
}


.stat-line {
    width: 1px;

    height: 35px;

    background: #292630;
}


/* ================= HERO VISUAL ================= */

.hero-visual {
    height: 540px;

    position: relative;

    display: flex;

    align-items: center;

    justify-content: center;
}


.visual-glow {
    position: absolute;

    width: 280px;

    height: 280px;

    border-radius: 50%;

    background:
        radial-gradient(
            circle,
            rgba(139, 92, 246, 0.30),
            rgba(99, 102, 241, 0.06),
            transparent 70%
        );

    filter: blur(15px);
}


.tech-circle {
    position: absolute;

    border-radius: 50%;

    border:
        1px solid
        rgba(167, 139, 250, 0.16);
}


.circle-large {
    width: 470px;

    height: 470px;

    animation:
        rotate 30s
        linear
        infinite;
}


.circle-medium {
    width: 350px;

    height: 350px;

    border-color:
        rgba(99, 102, 241, 0.20);

    animation:
        rotate-reverse 22s
        linear
        infinite;
}


.circle-small {
    width: 250px;

    height: 250px;

    border-color:
        rgba(196, 181, 253, 0.20);
}


.synthara-orb {
    width: 190px;

    height: 190px;

    border-radius: 50%;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    position: relative;

    z-index: 5;

    background:
        radial-gradient(
            circle at 35% 25%,
            #39236e,
            #15121f 70%
        );

    border:
        1px solid
        rgba(196, 181, 253, 0.25);

    box-shadow:
        0 0 80px
        rgba(124, 92, 255, 0.25),

        inset 0 0 50px
        rgba(124, 92, 255, 0.12);
}


.orb-letter {
    font-size: 58px;

    font-weight: 800;

    line-height: 1;

    background:
        linear-gradient(
            135deg,
            #ddd6fe,
            #818cf8
        );

    -webkit-background-clip: text;

    -webkit-text-fill-color: transparent;
}


.orb-name {
    margin-top: 8px;

    font-size: 15px;

    font-weight: 700;

    letter-spacing: 3px;
}


.orb-tag {
    margin-top: 2px;

    color: #8f8b9c;

    font-size: 7px;

    letter-spacing: 2px;
}


/* FLOATING CARDS */

.floating-card {
    position: absolute;

    z-index: 10;

    display: flex;

    align-items: center;

    gap: 10px;

    padding:
        12px
        15px;

    border:
        1px solid
        rgba(255, 255, 255, 0.09);

    border-radius: 10px;

    background:
        rgba(15, 14, 21, 0.82);

    backdrop-filter: blur(15px);

    box-shadow:
        0 15px 40px
        rgba(0, 0, 0, 0.35);
}


.floating-icon {
    width: 35px;

    height: 35px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 8px;

    background:
        rgba(139, 92, 246, 0.13);

    font-size: 17px;
}


.floating-card strong {
    display: block;

    font-size: 12px;
}


.floating-card small {
    display: block;

    color: #777482;

    font-size: 9px;
}


.card-one {
    top: 80px;

    left: 0;

    animation:
        float 5s
        ease-in-out
        infinite;
}


.card-two {
    right: -5px;

    top: 190px;

    animation:
        float 6s
        ease-in-out
        infinite
        1s;
}


.card-three {
    left: 20px;

    bottom: 70px;

    animation:
        float 5.5s
        ease-in-out
        infinite
        0.5s;
}


@keyframes rotate {

    from {
        transform: rotate(0);
    }

    to {
        transform: rotate(360deg);
    }

}


@keyframes rotate-reverse {

    from {
        transform: rotate(360deg);
    }

    to {
        transform: rotate(0);
    }

}


@keyframes float {

    0%,
    100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-12px);
    }

}


/* ================= GENERAL SECTION ================= */

.section {
    max-width: 1200px;

    margin: auto;

    padding:
        110px
        25px;
}


.section-heading {
    max-width: 700px;

    margin:
        0
        auto
        60px;

    text-align: center;
}


.section-label {
    color: #a78bfa;

    font-size: 11px;

    font-weight: 700;

    letter-spacing: 3px;
}


.section-heading h2 {
    margin:
        15px
        0;

    font-size: 48px;

    line-height: 1.1;

    letter-spacing: -1px;
}


.section-heading h2 span {
    color: #a78bfa;
}


.section-heading p {
    color: #85818f;

    font-size: 15px;
}


/* ================= ABOUT ================= */

.about {
    display: grid;

    grid-template-columns:
        0.9fr
        1.1fr;

    gap: 90px;

    align-items: center;
}


.about-visual {
    position: relative;

    min-height: 450px;

    display: flex;

    align-items: center;

    justify-content: center;
}


.about-glow {
    position: absolute;

    width: 260px;

    height: 260px;

    border-radius: 50%;

    background: #7c3aed;

    opacity: 0.13;

    filter: blur(90px);
}


.about-card {
    width: 340px;

    min-height: 390px;

    position: relative;

    z-index: 2;

    padding: 28px;

    display: flex;

    flex-direction: column;

    justify-content: center;

    align-items: center;

    text-align: center;

    background:
        linear-gradient(
            145deg,
            #17131f,
            #0b0a0f
        );

    border:
        1px solid
        rgba(255, 255, 255, 0.08);

    border-radius: 20px;

    box-shadow:
        0 30px 80px
        rgba(0, 0, 0, 0.4);
}


.about-card-top {
    width: 100%;

    position: absolute;

    top: 20px;

    left: 0;

    padding: 0 22px;

    display: flex;

    justify-content: space-between;

    color: #696571;

    font-size: 10px;

    letter-spacing: 2px;
}


.online-dot {
    width: 7px;

    height: 7px;

    border-radius: 50%;

    background: #a78bfa;

    box-shadow:
        0 0 10px
        #a78bfa;
}


.about-symbol {
    width: 105px;

    height: 105px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 50%;

    margin-bottom: 25px;

    font-size: 48px;

    font-weight: 800;

    background:
        linear-gradient(
            145deg,
            #30205a,
            #14101e
        );

    color: #c4b5fd;

    border:
        1px solid
        rgba(196, 181, 253, 0.2);

    box-shadow:
        0 0 50px
        rgba(139, 92, 246, 0.15);
}


.about-card h3 {
    font-size: 24px;

    line-height: 1.25;
}


.about-card p {
    color: #777481;

    font-size: 13px;

    margin-top: 10px;
}


.about-lines {
    width: 100%;

    margin-top: 35px;

    display: flex;

    flex-direction: column;

    gap: 7px;
}


.about-lines span {
    height: 3px;

    border-radius: 5px;

    background:
        linear-gradient(
            90deg,
            #8b5cf6,
            transparent
        );
}


.about-lines span:nth-child(1) {
    width: 100%;
}


.about-lines span:nth-child(2) {
    width: 75%;
}


.about-lines span:nth-child(3) {
    width: 50%;
}


.about-content h2 {
    font-size: 48px;

    line-height: 1.1;

    margin:
        15px
        0
        25px;
}


.about-content h2 span {
    display: block;

    color: #a78bfa;
}


.about-content p {
    color: #8c8996;

    margin-bottom: 18px;

    font-size: 15px;
}


.about-features {
    display: grid;

    grid-template-columns:
        1fr
        1fr;

    gap: 13px;

    margin-top: 30px;
}


.about-features div {
    color: #d4d0dd;

    font-size: 13px;
}


.about-features span {
    color: #a78bfa;

    margin-right: 8px;
}


/* ================= SERVICES ================= */

.services-grid {
    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 18px;
}


.service-card {
    min-height: 310px;

    padding: 27px;

    position: relative;

    overflow: hidden;

    background:
        linear-gradient(
            145deg,
            #121117,
            #0b0b0e
        );

    border:
        1px solid
        rgba(255, 255, 255, 0.065);

    border-radius: 15px;

    transition:
        transform 0.35s,
        border 0.35s,
        box-shadow 0.35s;
}


.service-card::before {
    content: "";

    position: absolute;

    width: 100px;

    height: 100px;

    right: -50px;

    top: -50px;

    border-radius: 50%;

    background: #8b5cf6;

    opacity: 0.06;

    filter: blur(30px);
}


.service-card:hover {
    transform:
        translateY(-8px);

    border-color:
        rgba(139, 92, 246, 0.35);

    box-shadow:
        0 25px 60px
        rgba(0, 0, 0, 0.3);
}


.service-number {
    position: absolute;

    top: 22px;

    right: 22px;

    color: #403b4a;

    font-size: 11px;

    font-weight: bold;
}


.service-icon {
    width: 52px;

    height: 52px;

    display: flex;

    align-items: center;

    justify-content: center;

    margin-bottom: 25px;

    border-radius: 12px;

    background:
        linear-gradient(
            145deg,
            rgba(139, 92, 246, 0.17),
            rgba(99, 102, 241, 0.07)
        );

    color: #c4b5fd;

    font-size: 25px;

    border:
        1px solid
        rgba(167, 139, 250, 0.12);
}


.service-card h3 {
    font-size: 18px;

    margin-bottom: 12px;
}


.service-card p {
    min-height: 72px;

    color: #7e7a87;

    font-size: 13px;

    line-height: 1.7;
}


.learn-btn {
    padding: 0;

    margin-top: 18px;

    background: none;

    border: none;

    color: #a78bfa;

    font-size: 12px;

    font-weight: 700;

    cursor: pointer;
}


.learn-btn span {
    margin-left: 6px;

    transition: 0.3s;
}


.learn-btn:hover span {
    margin-left: 12px;
}


/* ================= TECHNOLOGY ================= */

.technology {
    text-align: center;
}


.technology-grid {
    max-width: 950px;

    margin: auto;

    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 14px;
}


.technology-item {
    padding: 20px;

    border:
        1px solid
        rgba(255, 255, 255, 0.07);

    border-radius: 10px;

    background: #0e0d12;

    color: #aaa6b4;

    font-size: 13px;

    transition: 0.3s;
}


.technology-item:hover {
    color: white;

    border-color:
        rgba(139, 92, 246, 0.35);

    background:
        rgba(139, 92, 246, 0.06);
}


/* ================= WHY ================= */

.why-grid {
    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 20px;
}


.why-card {
    padding: 30px;

    border-top:
        1px solid
        #292630;

    background:
        linear-gradient(
            180deg,
            rgba(255, 255, 255, 0.015),
            transparent
        );
}


.why-number {
    color: #a78bfa;

    font-size: 11px;

    letter-spacing: 2px;
}


.why-card h3 {
    margin:
        15px
        0
        10px;

    font-size: 18px;
}


.why-card p {
    color: #777481;

    font-size: 13px;
}


/* ================= PROCESS ================= */

.process-grid {
    display: grid;

    grid-template-columns:
        repeat(5, 1fr);

    gap: 15px;
}


.process-item {
    text-align: center;

    padding: 10px;
}


.process-number {
    width: 58px;

    height: 58px;

    margin:
        0
        auto
        18px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 50%;

    color: #c4b5fd;

    border:
        1px solid
        rgba(167, 139, 250, 0.22);

    background:
        rgba(139, 92, 246, 0.08);

    font-size: 12px;

    font-weight: bold;
}


.process-item h3 {
    font-size: 16px;

    margin-bottom: 8px;
}


.process-item p {
    color: #777481;

    font-size: 12px;
}


/* ================= CONTACT ================= */

.contact {
    display: grid;

    grid-template-columns:
        0.9fr
        1.1fr;

    gap: 80px;

    align-items: center;
}


.contact-information h2 {
    font-size: 50px;

    line-height: 1.05;

    margin:
        18px
        0
        22px;
}


.contact-information h2 span {
    display: block;

    color: #a78bfa;
}


.contact-information > p {
    max-width: 520px;

    color: #85818f;

    font-size: 14px;

    line-height: 1.8;

    margin-bottom: 32px;
}


.contact-detail {
    display: flex;

    align-items: center;

    gap: 14px;

    margin-bottom: 20px;
}


.contact-detail-icon {
    width: 48px;

    height: 48px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 10px;

    color: #c4b5fd;

    background:
        rgba(139, 92, 246, 0.09);

    border:
        1px solid
        rgba(139, 92, 246, 0.12);
}


.contact-detail small {
    display: block;

    color: #5f5b68;

    font-size: 9px;

    letter-spacing: 2px;

    margin-bottom: 2px;
}


.contact-detail a,
.contact-detail span {
    color: #d7d3df;

    font-size: 13px;
}


.contact-form {
    padding: 35px;

    border:
        1px solid
        rgba(255, 255, 255, 0.07);

    border-radius: 17px;

    background:
        linear-gradient(
            145deg,
            #121117,
            #0b0b0f
        );

    box-shadow:
        0 30px 70px
        rgba(0, 0, 0, 0.25);
}


.form-group {
    margin-bottom: 17px;
}


.form-group label {
    display: block;

    color: #aaa6b4;

    font-size: 11px;

    margin-bottom: 7px;
}


.contact-form input,
.contact-form textarea,
.contact-form select {
    width: 100%;

    padding:
        13px
        14px;

    color: #eee;

    background: #0c0c10;

    border:
        1px solid
        #282630;

    border-radius: 8px;

    outline: none;

    font-size: 13px;

    transition: 0.3s;
}


.contact-form select {
    cursor: pointer;
}


.contact-form input:focus,
.contact-form textarea:focus,
.contact-form select:focus {
    border-color: #8b5cf6;

    box-shadow:
        0 0 0 3px
        rgba(139, 92, 246, 0.08);
}


.contact-form textarea {
    resize: vertical;
}


.submit-btn {
    width: 100%;

    justify-content: center;

    margin-top: 5px;
}


.form-note {
    margin-top: 12px;

    text-align: center;

    color: #55515e;

    font-size: 10px;
}


/* ================= FOOTER ================= */

.footer {
    border-top:
        1px solid
        rgba(255, 255, 255, 0.06);

    padding:
        65px
        25px
        20px;
}


.footer-content {
    max-width: 1200px;

    margin: auto;

    display: grid;

    grid-template-columns:
        2fr
        1fr
        1fr
        1fr;

    gap: 40px;
}


.footer-brand p {
    color: #77727f;

    margin-top: 12px;

    font-size: 13px;
}


.footer-brand .footer-description {
    max-width: 280px;

    line-height: 1.7;

    color: #5e5a66;
}


.footer-column h4 {
    margin-bottom: 14px;

    font-size: 13px;
}


.footer-column a {
    display: block;

    color: #6f6a77;

    margin-top: 9px;

    font-size: 12px;

    transition: 0.3s;
}


.footer-column a:hover {
    color: #a78bfa;
}


.footer-bottom {
    max-width: 1200px;

    margin:
        50px
        auto
        0;

    padding-top: 20px;

    border-top:
        1px solid
        rgba(255, 255, 255, 0.05);

    display: flex;

    justify-content: space-between;

    color: #55515e;

    font-size: 10px;
}


/* ================= SERVICE MODAL ================= */

.service-modal {
    position: fixed;

    inset: 0;

    z-index: 3000;

    display: none;

    align-items: center;

    justify-content: center;

    padding: 20px;

    background:
        rgba(0, 0, 0, 0.88);

    backdrop-filter: blur(10px);
}


.service-modal.active {
    display: flex;
}


.modal-box {
    width: 100%;

    max-width: 700px;

    max-height: 90vh;

    overflow-y: auto;

    position: relative;

    padding: 42px;

    border:
        1px solid
        rgba(167, 139, 250, 0.18);

    border-radius: 18px;

    background:
        linear-gradient(
            145deg,
            #17141f,
            #0d0c11
        );

    box-shadow:
        0 40px 100px
        rgba(0, 0, 0, 0.6);
}


.modal-close {
    position: absolute;

    top: 15px;

    right: 20px;

    width: 35px;

    height: 35px;

    border: none;

    border-radius: 50%;

    background:
        rgba(255, 255, 255, 0.06);

    color: #aaa;

    font-size: 24px;

    cursor: pointer;
}


.modal-close:hover {
    color: white;

    background:
        rgba(139, 92, 246, 0.15);
}


.modal-service-icon {
    width: 60px;

    height: 60px;

    display: flex;

    align-items: center;

    justify-content: center;

    margin-bottom: 20px;

    border-radius: 13px;

    color: #c4b5fd;

    background:
        rgba(139, 92, 246, 0.10);

    font-size: 28px;
}


.modal-box h2 {
    margin:
        12px
        0
        15px;

    font-size: 34px;
}


.modal-box > p {
    color: #92909d;

    font-size: 14px;

    line-height: 1.8;

    margin-bottom: 30px;
}


.modal-box h3 {
    margin-bottom: 15px;

    font-size: 15px;
}


.modal-features {
    display: grid;

    grid-template-columns:
        1fr
        1fr;

    gap: 8px;

    margin-bottom: 30px;
}


.modal-feature {
    padding:
        11px
        13px;

    border:
        1px solid
        rgba(255, 255, 255, 0.05);

    border-radius: 7px;

    background:
        rgba(255, 255, 255, 0.025);

    color: #bbb7c4;

    font-size: 12px;
}


.modal-feature::before {
    content: "✓";

    color: #a78bfa;

    margin-right: 8px;
}


.modal-btn {
    display: inline-flex;
}


/* ================= BACK TO TOP ================= */

.back-top {
    position: fixed;

    right: 25px;

    bottom: 25px;

    width: 42px;

    height: 42px;

    z-index: 500;

    display: none;

    align-items: center;

    justify-content: center;

    border:
        1px solid
        rgba(167, 139, 250, 0.2);

    border-radius: 50%;

    background:
        rgba(15, 13, 20, 0.9);

    color: #c4b5fd;

    cursor: pointer;

    font-size: 18px;
}


.back-top.show {
    display: flex;
}


/* ================= RESPONSIVE ================= */

@media (max-width: 1050px) {

    .services-grid {
        grid-template-columns:
            repeat(2, 1fr);
    }


    .why-grid {
        grid-template-columns:
            repeat(2, 1fr);
    }


    .process-grid {
        grid-template-columns:
            repeat(3, 1fr);
    }

}


@media (max-width: 850px) {

    .nav-links,
    .nav-btn {
        display: none;
    }


    .menu-btn {
        display: block;
    }


    .nav-links.active {
        position: absolute;

        top: 78px;

        left: 0;

        width: 100%;

        padding: 25px;

        display: flex;

        flex-direction: column;

        align-items: flex-start;

        gap: 18px;

        background:
            rgba(8, 8, 11, 0.97);

        border-bottom:
            1px solid
            rgba(255, 255, 255, 0.07);
    }


    .hero {
        grid-template-columns: 1fr;

        text-align: center;
    }


    .hero-description {
        margin-left: auto;

        margin-right: auto;
    }


    .hero-buttons,
    .hero-stats {
        justify-content: center;
    }


    .hero-visual {
        margin-top: 20px;
    }


    .about,
    .contact {
        grid-template-columns: 1fr;
    }


    .about-content {
        text-align: center;
    }


    .about-features {
        text-align: left;
    }


    .section-heading {
        margin-bottom: 45px;
    }


    .footer-content {
        grid-template-columns:
            repeat(2, 1fr);
    }

}


@media (max-width: 600px) {

    .hero {
        padding-top: 125px;
    }


    .hero h1 {
        font-size: 43px;

        letter-spacing: -1.5px;
    }


    .hero-description {
        font-size: 15px;
    }


    .hero-stats {
        gap: 12px;
    }


    .stat-line {
        height: 28px;
    }


    .stat strong {
        font-size: 16px;
    }


    .stat span {
        font-size: 8px;
    }


    .hero-visual {
        height: 400px;
    }


    .circle-large {
        width: 340px;

        height: 340px;
    }


    .circle-medium {
        width: 270px;

        height: 270px;
    }


    .circle-small {
        width: 190px;

        height: 190px;
    }


    .synthara-orb {
        width: 145px;

        height: 145px;
    }


    .orb-letter {
        font-size: 42px;
    }


    .orb-name {
        font-size: 11px;
    }


    .floating-card {
        padding: 8px 10px;
    }


    .card-one {
        left: -5px;
    }


    .card-two {
        right: -5px;
    }


    .card-three {
        left: 0;
    }


    .section {
        padding:
            80px
            20px;
    }


    .section-heading h2,
    .about-content h2 {
        font-size: 38px;
    }


    .services-grid,
    .why-grid {
        grid-template-columns: 1fr;
    }


    .technology-grid {
        grid-template-columns:
            1fr
            1fr;
    }


    .process-grid {
        grid-template-columns:
            1fr;
    }


    .about-features {
        grid-template-columns: 1fr;
    }


    .contact-information h2 {
        font-size: 40px;
    }


    .contact-form {
        padding: 25px;
    }


    .modal-box {
        padding: 30px 22px;
    }


    .modal-box h2 {
        font-size: 27px;
    }


    .modal-features {
        grid-template-columns: 1fr;
    }


    .footer-content {
        grid-template-columns: 1fr;
    }


    .footer-bottom {
        flex-direction: column;

        gap: 8px;
    }

}
